# --- Data store ---
# If DATABASE_URL is set, the app uses PostgreSQL (server/pgStore.js) and its
# data survives restarts and deploys — required on any host with an ephemeral
# filesystem (Render, Railway, Fly). If it's unset, the app falls back to a
# local SQLite file (server/database.db) for zero-config local development.
# On Render this is injected automatically from the managed database in
# render.yaml, so you don't set it by hand there. Managed/remote Postgres
# (Render, Neon, Supabase) needs sslmode; the code enables SSL automatically
# for any non-localhost host.
# DATABASE_URL=postgresql://user:password@host:5432/linguaguard

# Safaricom Daraja API credentials.
# Register a free app at https://developer.safaricom.co.ke ("My Apps" > "Add a new app",
# with the "Lipa Na M-Pesa Sandbox" product enabled) to get your own Consumer Key/Secret.
# NEVER put these in src/ or anything prefixed VITE_ — that code ships to the browser.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Public sandbox test shortcode + passkey, published by Safaricom for Daraja
# sandbox testing (safe to keep as-is; verify against your own dashboard if
# Safaricom has rotated them).
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Must be a syntactically valid HTTPS URL for Safaricom to accept the STK push
# request, but it doesn't need to be reachable — the app polls
# /api/mpesa/status instead of waiting on this callback. Point it at a real
# public URL (e.g. an ngrok tunnel to this server) if you want the callback
# to also fire.
MPESA_CALLBACK_URL=https://example.com/api/mpesa/callback

MPESA_SERVER_PORT=4000

# --- Auth ---
# Sign/verify user session tokens. MUST be a long random string in production
# (e.g. `openssl rand -hex 32`) — the code falls back to an insecure default
# if this is unset, which is fine for local testing only. Leaving this unset
# now prints a loud warning on server start, since the fallback string is
# public (it's in this repo's source).
JWT_SECRET=change-me-to-a-long-random-string

# Restricts CORS to this origin instead of allowing any site to call the API.
# Leave unset for local dev (the Vite proxy makes requests same-origin
# anyway) — set it to your real frontend URL once deployed somewhere the
# browser calls this server cross-origin directly.
ALLOWED_ORIGIN=

# First run seeds one admin account if the user store is empty. If you don't
# set SEED_ADMIN_PASSWORD, a random one is generated and printed once to the
# server's console log — copy it from there.
SEED_ADMIN_EMAIL=admin@linguaguard.local
SEED_ADMIN_PASSWORD=

# --- Telegram (real platform connection) ---
# Create a bot with https://t.me/BotFather (`/newbot`) — no app review needed.
# BOT_USERNAME is the public @handle (without the @) BotFather gives you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Email (password reset codes) ---
# Optional. If left unset, the server auto-creates a disposable Ethereal test
# inbox on first use — reset emails "send" successfully and a preview link is
# printed to the server console, so the flow works out of the box with no
# setup. Set these to actually deliver to real inboxes (e.g. Gmail: host
# smtp.gmail.com, port 587, an App Password as SMTP_PASS — not your real
# password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LinguaGuard <no-reply@linguaguard.local>"

# --- SMS + WhatsApp (reset codes, verification codes, violation alerts) ---
# Two providers supported; Termii is tried first, TopMessage second, and if
# neither is configured the server logs codes to its own console so flows
# stay testable locally.
#
# Termii (https://termii.com) — also carries the WhatsApp channel used for
# the WhatsApp platform's verification codes. The sender ID must be
# REQUESTED AND APPROVED for your destination country in the Termii
# dashboard first; until then sends fail with SENDER_ID_NOT_APPROVED.
TERMII_API_KEY=
TERMII_SENDER_ID=LINGUAGUARD
# Optional: a Termii email configuration ID routes password-reset codes
# through Termii's email-OTP product (alerts/digests always use SMTP below).
# Requires the email configuration to be fully set up (verified sender) in
# the Termii dashboard — otherwise sends fall back to SMTP automatically.
TERMII_EMAIL_CONFIG_ID=
#
# TopMessage (https://topmessage.com) — SMS only. Sender ID must exactly
# match one registered on your TopMessage account.
TOPMESSAGE_API_KEY=
TOPMESSAGE_SENDER_ID=LINGUAGUARD

# --- X / Twitter (real OAuth 2.0 + PKCE platform connection) ---
# From your app's "Keys and tokens" page at https://developer.x.com —
# the Consumer Key/Secret pair (NOT the OAuth 1.0a-only ones — this app must
# have OAuth 2.0 enabled under "User authentication settings").
# You must add this exact URL as a Callback URI in that same settings page,
# or the redirect will fail: http://localhost:4000/api/oauth/x/callback
# (swap the host for your real domain once deployed).
# Reading the connected user's own profile (GET /2/users/me) is billed under
# X's pay-per-usage API pricing — the connection itself still succeeds even
# if that call is blocked by billing; the account just shows a generic name.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- TikTok (real OAuth 2.0 + PKCE platform connection) ---
# From your app at https://developers.tiktok.com — Login Kit must be added
# to the app, with this exact URL registered as the Redirect URI:
# http://localhost:4000/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Other platforms (Instagram/Facebook/WhatsApp/YouTube/etc.) ---
# These require your own developer app registered directly with each
# platform. Meta (Instagram/Facebook/WhatsApp) additionally requires
# business verification + App Review before it returns real user data — a
# review process only the account owner can start. Until you have real
# credentials, the Connections page keeps these as a simulated demo flow
# instead of pretending to fetch live data.
