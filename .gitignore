# --- Dependencies and build output ---
# These were tracked by mistake, which made node_modules 99.5% of the repo
# (21,380 of 21,475 files). Hosts run their own `npm install` and `npm run
# build`, so committing them slows deploys and can break builds when a
# committed binary doesn't match the host's platform.
node_modules/
dist/
.venv/

# --- Editor / logs ---
.vscode/
*.log

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
server/db.json
server/db.json.migrated
server/db.json.pre-sqlite-backup
server/database.db
server/database.db-wal
server/database.db-shm
server/.seed-admin-credentials.txt

# One-shot local maintenance script — not part of the app
server/scripts/update-admin-email.js
